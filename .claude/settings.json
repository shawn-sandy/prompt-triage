{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *",
      "gh auth status",
      "gh pr *",
      "gh run *",
      "gh issue *",
      "gh api *",
      "gh release list *"
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--exec*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-plugin.mjs\"",
            "timeout": 60,
            "statusMessage": "Validating plugin manifest"
          }
        ]
      }
    ]
  }
}
